# Keep secrets, local state and development files OUT of the build context (and therefore out of the image).
.git
.gitignore
.gitattributes
.github
.env
.env.*
!.env.example
.venv
venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
coverage.xml
htmlcov
test-results
# local state: databases, approval stores, ledgers, logs
data
logs
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-*
**/*.jsonl
**/*.log
**/*.bak
# not needed at run time
tests
docs
phase2-evidence-backup
phase3-diagnostics-review.txt
*.md
Dockerfile
docker-compose*.yml
.dockerignore
.vscode
.idea
.DS_Store
Thumbs.db
