# Copy to .env and fill in real values. Never commit .env.
# Placeholder values only.

# Required for /ready to report ready. Keep the real key out of source control.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Model identifier used by later phases. Confirm the model is available to your account.
OPENAI_MODEL=gpt-4o-mini

# development | test | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Used by `python -m app.main`
API_HOST=127.0.0.1
API_PORT=8000

# ---- Phase 2: simulated operational environment (SQL Server) ----------------------
# Server or server\instance. Your local SQL Server Express instance is named below:
# find yours with `Get-Service MSSQL*` (see docs/windows-setup.md).
DB_SERVER=localhost\SQLEXPRESS03
DB_NAME=dataops_sim

# windows = integrated authentication with your Windows account (default).
# sql     = a restricted SQL login (create it with `python -m scripts.db_create_app_login`),
#           then set DB_USER and DB_PASSWORD. NEVER commit real credentials.
DB_AUTH_MODE=windows
DB_USER=
DB_PASSWORD=

DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
# Local development only: accept SQL Server's self-signed certificate (the connection is
# still encrypted). Never set this for a remote server.
DB_TRUST_SERVER_CERTIFICATE=true
DB_LOGIN_TIMEOUT_SECONDS=5

# Deterministic baseline seed and freshness threshold (minutes) used by the simulation.
SIM_SEED=20260115
FRESHNESS_THRESHOLD_MINUTES=1500
# Generated JSON Lines run logs are written under this directory (git-ignored).
SIM_LOG_DIR=logs

# ---- Phase 5: AI DataOps agent (placeholders only; the real key goes in your local .env) -------
# OPENAI_API_KEY and OPENAI_MODEL above are used by the agent. Optional budgets (defaults shown):
# AGENT_MAX_ROUNDS=3
# AGENT_MAX_TOOL_CALLS=12
# AGENT_MAX_CALLS_PER_ROUND=4
# AGENT_TOOL_TIMEOUT_SECONDS=60
# AGENT_LLM_TIMEOUT_SECONDS=60
# AGENT_LLM_MAX_RETRIES=2
# AGENT_MAX_INCIDENT_CHARS=2000

# Phase 7 human approval (all optional; with none set, nobody can approve and no recovery can run).
# APPROVAL_AUTH_MODE=disabled          # or dev_static (LOCAL DEVELOPMENT ONLY; refused when APP_ENV=production)
# APPROVAL_DEV_CREDENTIALS=            # JSON list of {"subject","token_sha256","roles"}; digests only, never tokens
# APPROVAL_SIGNING_KEY=                # server-held key, at least 32 bytes; generate your own, never commit it
# APPROVAL_STORE_PATH=                 # default data/approvals.sqlite3
# GOVERNANCE_LEDGER_PATH=              # default data/governance_ledger.jsonl

# ---- Phase 8: API, persistence and ticketing (placeholders only; never commit real values) ------
# Operational database for incidents, investigations, recoveries and ticket links. SQLite file only.
# Must NOT point at the simulation database. Created/updated by an explicit migration, never destructively.
# DATABASE_URL=sqlite:///data/operations.sqlite3
# offline (deterministic, no LLM) or live (uses OPENAI_API_KEY)
# INVESTIGATION_MODE=offline
# API authentication reuses APPROVAL_AUTH_MODE / APPROVAL_DEV_CREDENTIALS above. There is no separate API_AUTH_MODE.
# GitHub Issues ticketing (all of the first three are required to enable it; leave empty to disable):
# GITHUB_TOKEN=                        # fine-grained token with Issues read/write on ONE repository
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_API_URL=https://api.github.com   # optional; must be https

# ---- Phase 9: deployment (placeholders only) ---------------------------------------------------------------
# APP_ENV=development                  # development | test | production
#   In production the process REFUSES TO START unless these are set explicitly (names are reported, never values):
#   DATABASE_URL, APPROVAL_STORE_PATH, GOVERNANCE_LEDGER_PATH, DB_NAME  - and APPROVAL_AUTH_MODE must not be dev_static.
#   Inside the container the first three default to files under /data (the one volume); DB_NAME is never defaulted.
# Note: DATABASE_URL, APPROVAL_*, GOVERNANCE_LEDGER_PATH, GITHUB_* and INVESTIGATION_MODE are read from the process
# environment (set them in your shell or with `docker run -e`), not from this file.


# ---- Phase 10: Operations Dashboard and VerbaLedger Explorer (placeholders only; set in YOUR shell, not read from this file)
# Install the UI dependencies first:  pip install -r requirements-dashboard.txt
# DASHBOARD_API_BASE_URL=http://127.0.0.1:8000/api/v1   # the existing FastAPI app; http(s), no credentials in the URL
# DASHBOARD_API_TOKEN=                  # Operations Dashboard read token (viewer/api_reader role). Never displayed or logged.
# DASHBOARD_INVESTIGATE_TOKEN=          # Optional: token with investigation:run (investigator/operator role) for the Investigate button.
#                                       # If unset, the page asks for your own token (masked, not stored). Never displayed or logged.
# LEDGER_EXPLORER_API_TOKEN=            # separate token for the Explorer; its role needs ledger:read (viewer/approver/admin)
# DASHBOARD_REQUEST_TIMEOUT_SECONDS=10  # 1-60
# DASHBOARD_MAX_INCIDENTS=300           # 20-1000 incidents loaded into the dashboard
# LEDGER_MAX_SCAN_LINES=200000          # API side: ledger lines scanned per read (view is flagged incomplete if exceeded)
# LEDGER_MAX_SCAN_BYTES=134217728       # API side: ledger bytes scanned per read

# ---- Phase 10.1: cross-navigation and import (placeholders only)
# OPS_DASHBOARD_URL=http://127.0.0.1:8501     # link target used by the VerbaLedger Explorer
# LEDGER_EXPLORER_URL=http://127.0.0.1:8502   # link target used by the Operations Dashboard
# IMPORT_API_TOKEN=                           # operator token for scripts/import_simulator_incidents.py (never on the command line)
