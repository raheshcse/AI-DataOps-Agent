# Secrets / local configuration
.env
.env.*
!.env.example

# Python environment and caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test / coverage artifacts
.coverage
coverage.xml
htmlcov/

